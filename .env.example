# Copiar a .env. Este archivo no contiene credenciales.
MOLT_DATA_DIR=.data
MOLT_HOST=127.0.0.1
MOLT_PORT=8000
MOLT_WORKER_ENABLED=true
# Activar detrás de HTTPS en producción.
MOLT_SECURE_COOKIES=false

# En Render: PostgreSQL persistente de Neon. Credenciales solo en ajustes seguros.
# Dejar vacío para conservar el modo SQLite local.
DATABASE_URL=
# Solo crea al propietario si aún no existe; no reemplaza contraseñas anteriores.
MOLT_INITIAL_USERNAME=propietario
MOLT_INITIAL_PASSWORD=

# Correo por HTTPS con Resend. El remitente debe estar autorizado por el proveedor.
RESEND_API_KEY=
MOLT_MAIL_FROM=
MOLT_MAIL_TO=

# Dominio propio, después de registrarlo y configurarlo. No se supone que esté disponible.
MOLT_PUBLIC_URL=
MOLT_GOOGLE_SITE_VERIFICATION=
# Solo para el despliegue Docker con Caddy, sin https://.
MOLT_SITE_DOMAIN=
